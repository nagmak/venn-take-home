{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "group": ["**/test/**"], "message": "Test-only code must not be imported by app code." }]
          }
        ]
      }
    },
    {
      "files": ["src/api/**", "src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/test/**"], "message": "Test-only code must not be imported by app code." },
              { "group": ["**/features/**"], "message": "api/ and components/ must not depend on features/." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
